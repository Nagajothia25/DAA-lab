#include<iostream>
#include<cmath>
#include<cfloat>
using namespace std;
double distance(double x1,double y1,double x2,double y2){
   double dx=x2-x1;
   double dy=y2-y1;
   return sqrt(dx*dx+dy*dy);
}
int main() {
   int n;
   cout<<"Enter the number of points:";
   cin>>n;
   double x[n],y[n];
   cout<<"Enter the points:\n";
   for(int i=0;i<n;i++){
      cin>>x[i]>>y[i];
   }
   double d=99999;
   int p1=0,p2=1;
   cout<<"\nDistance between each pair:";
   for(int i=0;i<n-1;i++){
      for(int j=i+1;j<n;j++){
         double dis = distance(x[i], y[i], x[j], y[j]);
         cout << "(" << x[i] << "," << y[i] << ") - (" << x[j] << "," << y[j] << ") = " << dis << endl;
         if(dis<d){
            d=dis;
            p1=i;
            p2=j;
         }
      }
   }
   cout<<"\nClosest pair:"<<"("<<x[p1]<<","<<y[p1]<<")"<<"-"<<"("<<x[p2]<<","<<y[p2]<<")"<<endl;
   cout<<"Closest distance:"<<d<<endl;
   return 0;
}
