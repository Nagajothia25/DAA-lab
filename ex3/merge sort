#include<iostream>
using namespace std;
void merge(int b[],int p,int c[],int q,int a[]){
        int i=0,j=0,k=0;
        while(i<p && j<q){
                if(b[i]<=c[j])
                   a[k++]=b[i++];
                else
                   a[k++]=c[j++];
        }
        while(i<p){
                a[k++]=b[i++];
        }
        while(j<p){
                a[k++]=c[j++];
        }
}
void mergesort(int a[],int n){
        if(n>1){
                int mid=n/2;
                int b[mid];
                int c[n-mid];
                for(int i=0;i<mid;i++)
                   b[i]=a[i];
                for(int i=mid;i<n;i++)
                   c[i-mid]=a[i];
                mergesort(b,mid);
                mergesort(c,n-mid);
                merge(b,mid,c,n-mid,a);
        }
}
int main() {
        int n;
        cout<<"Enter number of elements:";
        cin>>n;
        int a[n];
        cout<<"Enter elements:\n";
        for(int i=0;i<n;i++)
           cin>>a[i];
        mergesort(a,n);
        cout<<"Sorted array:\n";
        for(int i=0;i<n;i++)
           cout<<a[i]<<" ";
        return 0;
}
