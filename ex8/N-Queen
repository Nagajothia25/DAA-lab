#include<iostream>
#include<vector>
#include<cmath>
using namespace std;
int x[50];
int count=0;
bool place(int k,int i){
   for(int j=1;j<=k-1;j++){
      if((x[j]==i)||(abs(x[j]-i)==abs(j-k))){
         return false;
      }
   }
   return true;
}
void nqueen(int k,int n){
   for(int i=1;i<=n;i++){
      if(place(k,i)){
         x[k]=i;
         if(k==n){
            for(int j=1;j<=n;j++){
               cout<<x[j]<<" ";
            }
            cout<<endl;
            for(int j=1;j<=n;j++){
               int z=x[j];
               cout<<endl;
               for(int v=1;v<=n;v++){
                  if(v==z)
                     cout<<"Q"<<" ";
                  else
                     cout<<"$"<<" ";
               }
               cout<<endl;
            }
            count++;
            cout<<"--------------------------------------"<<endl;
         }
         else{
            nqueen(k+1,n);
         }
      }
   }
}
int main(){
   int n;
   cout<<"Enter no of queens:";
   cin>>n;
   if(n>0 && n<50){
      nqueen(1,n);
   }
   cout<<"Total possible combinations:"<<count<<endl;
   return 0;
}
